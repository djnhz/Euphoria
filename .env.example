# Neon Postgres — via Vercel Marketplace, of een eigen connection string
DATABASE_URL="postgresql://gebruiker:wachtwoord@host/db?sslmode=require"

# Vercel Blob — via Vercel Marketplace
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Sessieversleuteling. Minimaal 32 tekens.
# Genereer met: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# Bonanalyse. Allebei optioneel: laat ze leeg en vul de sleutel in bij Instellingen,
# dan staat hij versleuteld in de database. Staat hier wel een waarde, dan gaat die voor
# en kan het scherm hem niet wijzigen.
OPENAI_API_KEY=""
OPENAI_MODEL=""
